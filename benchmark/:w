"""Lasttest-Szenario für den Event-Roundtrip.

Sendet pro Task-Ausführung eine konfigurierbare Anzahl von POST-Requests
und liest die entsprechenden Events direkt aus dem SSE-Stream.
Am Ende wird geprüft ob die Anzahl der empfangenen Events mit der
Anzahl der gesendeten Requests übereinstimmt.
"""

# ----------------------------------------------------------------------------------------------------------------------

import base64
import random
import time
from datetime import datetime, timezone
from typing import Optional

import gevent
import requests
from locust import constant, events, task

from config.settings import REQUEST_TIMEOUT, REQUESTS_PER_TASK, TARGET_NODE_NAME
from scenarios.base import PlutoBaseUser

# ----------------------------------------------------------------------------------------------------------------------

SSE_PATH: str = "/runtime/events/"
"""URL-Pfad des SSE-Eventstream-Endpunkts."""

POST_PATH: str = "/runtime/events/"
"""URL-Pfad des POST-Endpunkts für Node-Events."""


class EventRoundtripUser(PlutoBaseUser):
    """Locust-User für den Event-Roundtrip-Lasttest.

    Öffnet pro Task eine SSE-Verbindung, sendet REQUESTS_PER_TASK
    POST-Requests und liest die entsprechenden Events aus dem Stream.
    Meldet einen Fehler wenn nicht alle Events empfangen wurden.
    """

    wait_time = constant(5)

    @task
    def event_roundtrip(self) -> None:
        """Öffnet SSE-Verbindung, sendet N POSTs und liest N Events.

        Die SSE-Verbindung wird innerhalb der Task-Funktion geöffnet
        und nach dem Lesen aller Events wieder geschlossen. Das Lesen
        wird nach REQUEST_TIMEOUT Sekunden abgebrochen.
        """
        sent_count: int = 0
        received_count: int = 0
        start_time: float = time.monotonic()

        with requests.get(
            f"{self.host}{SSE_PATH}",
            stream=True,
            timeout=None,
        ) as sse_response:

            for _ in range(REQUESTS_PER_TASK):
                node_id: int = random.randint(0, 4294967295)
                event_id: int = random.randint(0, 4294967295)
                timestamp: datetime = datetime.now(tz=timezone.utc)
                tz: str = timestamp.strftime("%z")
                formatted_ts: str = (
                    f"{timestamp.strftime('%Y-%m-%dT%H:%M:%S')}"
                    f".{timestamp.microsecond // 100000}"
                    f"{tz[:3]}:{tz[3:]}"
                )
                payload: str = base64.b64encode(b"benchmark").decode("utf-8")

                with self.client.post(
                    POST_PATH,
                    json={
                        "id": node_id,
                        "event_id": event_id,
                        "timestamp": formatted_ts,
                        "payload": payload,
                        "target_node_name": TARGET_NODE_NAME,
                    },
                    catch_response=True,
                ) as response:
                    if response.ok:
                        sent_count += 1
                    else:
                        response.failure(f"POST fehlgeschlagen: {response.status_code}")

            with gevent.Timeout(REQUEST_TIMEOUT, False):
                for line in sse_response.iter_lines():
                    if line and not line.startswith(b":"):
                        received_count += 1
                        if received_count >= sent_count:
                            break

        elapsed_ms: float = (time.monotonic() - start_time) * 1000
        exception: Optional[Exception] = None
        if received_count < sent_count:
            exception = AssertionError(
                f"Nur {received_count}/{sent_count} Events über SSE empfangen."
            )

        events.request.fire(
            request_type="SSE",
            name="event_roundtrip",
            response_time=elapsed_ms,
            response_length=received_count,
            exception=exception,
        )

    # ------------------------------------------------------------------------------------------------------------------
