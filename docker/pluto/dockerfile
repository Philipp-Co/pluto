# https://docs.docker.com/build/building/multi-stage/
#
#
# Konfiguration unter:
#   /bin/
#       pluto_*
#       ...
#
#   /pluto/config/
#       core.cfg
#       node_name_0.cfg
#       ...
#
#   /pluto/nodes/node_name_0/
#       .venv/
#
#   /pluto/nodes/node_name_1/
#   ...
#
#
# ---------------------------------------------------------------------------------------------------------------------
#

#
# Wie kann man Daten wiederverwenden?
#   - Dateisystem mappen?
#       - /pluto/ auf Hostsystem mappen
#

#
# ---------------------------------------------------------------------------------------------------------------------
#
from ubuntu:20.04 as pluto_builder

RUN echo "Europe/Berlin" > /etc/timezone
RUN apt-get update && apt-get upgrade -y
RUN apt install software-properties-common -y
RUN add-apt-repository ppa:deadsnakes/ppa
RUN apt-get install python3.8-dev -y
RUN apt-get install python3-pip -y
RUN apt install python3.8-venv -y
RUN apt-get install cmake -y
#RUN apt-get install python3-dev -y
RUN apt-get install git -y

#
# Copy C Source Files...
#
COPY ../pluto_config/ /pluto_config/
COPY ../pluto_os_abstraction/ /pluto_os_abstraction/
COPY ../pluto_node/ /pluto_node/
COPY ../pluto_edge/ /pluto_edge/
COPY ../pluto_core/ /pluto_core/
COPY ../CMakeLists.txt /
#
# Download external Dependencies like Testframework and JSON Parser...
#
RUN cd / && mkdir /external/ && cd /external/ && git clone https://github.com/zserge/jsmn.git && git clone https://github.com/ThrowTheSwitch/Unity.git
#
# Build the Executables...
#
RUN mkdir /build/ && cd /build/ && cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release -DPLUTO_TARGET_OS=2 -DPLUTO_OS_INTERFACE=1 ../
RUN cd /build/ && make VERBOSE=1
RUN cd /build/ && make install
#
# Create needed Directorystructure...
#
RUN mkdir /pluto/ && mkdir /pluto/core/ && mkdir /pluto/core/config/ && mkdir /pluto/nodes/
RUN touch /pluto/core/config/core.cfg && echo "{\"nodes\":[]}" > /pluto/core/config/core.cfg
#
# Copy Setup Scripts...
#
COPY ./plyto/ /plyto/
#
# Create Venv...
#
RUN python3 -m venv .venv
RUN . .venv/bin/activate && pip install build typing_extensions
RUN . .venv/bin/activate && cd /plyto/ && python3 -m build --sdist && pip install dist/plyto-0.0.0.tar.gz
#
# ---------------------------------------------------------------------------------------------------------------------
#

# Multistage Build

#
# ---------------------------------------------------------------------------------------------------------------------
#

from ubuntu:20.04 as pluto_runtime

#
# Need Python
#
RUN echo "Europe/Berlin" > /etc/timezone
RUN apt-get update && apt-get upgrade -y
RUN apt install software-properties-common -y
RUN add-apt-repository ppa:deadsnakes/ppa
RUN apt-get install python3.8-dev -y
RUN apt-get install python3-pip -y
RUN apt install python3.8-venv -y

#
# Copy Executables from Builder...
#
COPY --from=pluto_builder /usr/local/bin/pluto_core /usr/local/bin/
COPY --from=pluto_builder /usr/local/bin/pluto_node_* /usr/local/bin/
COPY --from=pluto_builder /usr/local/lib/libpluto_* /usr/local/lib/
COPY --from=pluto_builder /pluto/ /pluto/
#
# Copy Venv fomr Builder...
#
COPY --from=pluto_builder /.venv/ /.venv/
ENV VIRTUAL_ENV=/.venv/
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
#
# Copy Pluto Directories from Builder...
#
COPY --from=pluto_builder ./pluto/ /pluto/

COPY pluto_http_interface/ /pluto_http_interface/

#
# ---------------------------------------------------------------------------------------------------------------------
#

ENV PYTHONUNBUFFERED=1
ENV PLUTO_WORKDIR='/pluto/'
ENV PLUT_SHARED_LIBRARY_EXTENSION='so'
#
# Start the Container. Execute pluto_core.
# pluto_core will start to manage pluto_nodes according to the given configuration.
#
CMD ["pluto_core", "-c", "/pluto/core/config/core.cfg"]

#
# ---------------------------------------------------------------------------------------------------------------------
#

#
# How to extend this Image:
# 
#
# from pluto_runtime:latest
# 
# # Copy Stuff over...
COPY ./docker/demo/pluto_python_demo/dist/examplenode-0.0.0.tar.gz /examplenode.tar.gz
# # Add and connect Nodes.
RUN plyto_add_node_pt name_0                                    # Create a passthrough Node with Name "name_0"
RUN plyto_add_node_py name_1 /examplenode.tar.gz examplenode    # Create a passthrough Node with Name "name_0"
RUN plyto_connect_nodes name_0 name_1                           # Connect Node name_0 with Node name_1: name_0 -> name_1

#
# ---------------------------------------------------------------------------------------------------------------------
#
